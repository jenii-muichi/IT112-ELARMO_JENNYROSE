#include <stdio.h>

int main() {
    int number;
    int total = 0;

    printf("Enter positive numbers to ADD (zero or negative number to STOP)\n");

    while (1) {
        printf("\nEnter a number: ");
        scanf("%d", &number);

        if (number <= 0) {
            break;
        }

        total = total + number;
    }

    printf("Total sum is: %d\n", total);

    return 0;
}
